# happy_whale_and_dolphin_reid Configuration
# Copy this file to .env and customize values

# Training Configuration
BATCH_SIZE=64
NUM_TRAIN_TRIPLETS=40000
NUM_VALID_TRIPLETS=20000
MARGIN=0.0001
EPOCHS=100
LEARNING_RATE=1e-4
WEIGHT_DECAY=0.0

# Model Configuration
EMBEDDING_DIMENSION=512
NUM_CLASSES=30

# GPU
CUDA_VISIBLE_DEVICES=0
DEVICE_ORDER=PCI_BUS_ID

# Data Paths (optional - uses default PROJECT_ROOT/dataset if not set)
# TRAIN_ROOT_DIR=/path/to/dataset/train
# VALID_ROOT_DIR=/path/to/dataset/valid
# TRAIN_CSV_NAME=/path/to/train_list.csv
# VALID_CSV_NAME=/path/to/val_list.csv
# ALL_CSV_NAME=/path/to/all_list.csv

# Checkpoint Paths
# WEIGHT_DIR=/path/to/weight
# OUTPUT_DIR=/path/to/output

# Metrics
MAP_K=5
