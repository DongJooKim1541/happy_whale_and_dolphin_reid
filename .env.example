# happy_whale_and_dolphin_reid Configuration
# Copy this file to .env and customize values

# Training Configuration
BATCH_SIZE=64
NUM_TRAIN_TRIPLETS=40000
NUM_VALID_TRIPLETS=20000
MARGIN=0.0001
EPOCHS=100
LEARNING_RATE=1e-4
WEIGHT_DECAY=0.0

# Loss weighting: total = CE_LOSS_WEIGHT * species_CE + triplet
CE_LOSS_WEIGHT=0.01

# Hard negative mining: candidates examined per anchor is k * batch_size, clamped to
# the gallery size. 1 keeps the search inside the current batch.
HARD_NEGATIVES_PER_ANCHOR=1

# Distance above which a query is judged to be a previously unseen individual
NEW_ID_THRESHOLD=0.1

# DataLoader worker processes (defaults to 0 on Windows, 4 elsewhere)
# NUM_WORKERS=4

# Model Configuration
MODEL_NAME=resnet18
PRETRAINED=1
EMBEDDING_DIMENSION=512
NUM_CLASSES=30

# GPU
CUDA_VISIBLE_DEVICES=0
DEVICE_ORDER=PCI_BUS_ID

# Data Paths (optional - uses default PROJECT_ROOT/dataset if not set)
# TRAIN_ROOT_DIR=/path/to/dataset/train
# VALID_ROOT_DIR=/path/to/dataset/valid
# TRAIN_CSV_NAME=/path/to/train_list.csv
# VALID_CSV_NAME=/path/to/val_list.csv
# ALL_CSV_NAME=/path/to/all_list.csv

# Checkpoint Paths
# WEIGHT_DIR=/path/to/weight
# OUTPUT_DIR=/path/to/output

# Metrics
MAP_K=5
